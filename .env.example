# ---------------------------------------------------------------------------
# Portfolio AI assistant — POST /api/chat
# ---------------------------------------------------------------------------

# Required. Without it the assistant returns 503 and the chat UI says so.
OPENAI_API_KEY=

# Optional. Any OpenAI model id; defaults to gpt-5.4-mini.
# Drop to gpt-4.1-mini if the account doesn't have gpt-5.x access.
# OPENAI_CHAT_MODEL=gpt-5.4-mini

# Optional. Enables the assistant's searchWeb / readWebPage tools via Firecrawl.
# Leave blank to run the assistant on portfolio data alone.
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# Contact form (POST /api/send) — also how the assistant forwards a visitor's
# contact details and any question it couldn't answer.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
RESEND_TO_EMAIL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, sitemap and OG images.
# NEXT_PUBLIC_SITE_URL=https://hiteshsolanki.dev
